{
  "description": "Advisory nudges after Dart/Python edits: complexity ceiling and cross-language model sync. Quiet when nothing applies.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/complexity_sensor_hook.py\"",
            "timeout": 20,
            "statusMessage": "Checking cyclomatic complexity..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sync_model_hook.py\"",
            "timeout": 20,
            "statusMessage": "Checking model sync..."
          }
        ]
      }
    ]
  }
}
